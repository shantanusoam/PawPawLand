# Copy to .env and adjust. Every variable the app reads is listed here.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
# Production only, comma-separated with scheme, e.g. http://example.com:8014
# CSRF_TRUSTED_ORIGINS=

# Email notifications for Contact/Registration form submissions (sent to
# SiteSettings.email). Leave unset for local dev — defaults to the console
# backend, which just prints emails to stdout instead of sending them.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@example.com
# Socket timeout (seconds) for SMTP sends — keeps a stalled mail server from
# hanging a worker indefinitely. Defaults to 20.
# EMAIL_TIMEOUT=20
# The registration notification email is sent off a background thread so a
# slow/large send can't stall the HTTP response. Defaults to True (False
# automatically under pytest, so tests can assert on mailoutbox).
# REGISTRATION_EMAIL_ASYNC=True
